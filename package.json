{
  "name": "truthy",
  "version": "3.0.0",
  "description": "Create truth tables without the pain",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleb531/truthy.git"
  },
  "keywords": [
    "truth tables",
    "mithril"
  ],
  "author": "Caleb Evans",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/caleb531/truthy/issues"
  },
  "homepage": "https://github.com/caleb531/truthy#readme",
  "dependencies": {
    "@fontsource/oxygen-mono": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "mithril": "^2.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/mithril": "^2.2.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "peggy": "^5.1.1",
    "prettier": "^3.10.1",
    "rollup-plugin-peggy": "6.2.0",
    "sass": "^1.108.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
